client.on("messageCreate", async (message) => {
  if (message.author.bot) return;

  const args = message.content.trim().split(/ +/);
  const command = args.shift().toLowerCase();

  if (command === "!getaccess") {
    const orderId = args[0];
    if (!orderId) {
      return message.reply(
        "Please provide your order number. Example: `!getaccess ORDER_123456`",
      );
    }

    try {
      const response = await fetch(`${SELLAPP_API}/${orderId}`, {
        headers: {
          Authorization: `Bearer ${process.env.SELLAPP_API_KEY}`,
        },
      });

      if (!response.ok) {
        return message.reply(
          "Order not found. Make sure you entered it correctly.",
        );
      }

      const data = await response.json();

      if (data.data.status !== "completed") {
        return message.reply("Your order is not completed yet.");
      }

      const guild = await client.guilds.fetch(process.env.GUILD_ID);
      const member = await guild.members.fetch(message.author.id);
      const role = guild.roles.cache.find(
        (r) => r.name === process.env.ROLE_NAME,
      );

      if (!role) {
        return message.reply("Role not found. Contact an admin.");
      }

      if (member.roles.cache.has(role.id)) {
        return message.reply("You already have access.");
      }

      await member.roles.add(role);
      message.reply(
        `✅ Access granted! You've been given the **${role.name}** role.`,
      );
    } catch (err) {
      console.error(err);
      message.reply("Something went wrong. Contact support.");
    }
  }
});

