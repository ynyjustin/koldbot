  if (interaction.commandName === "logs") {
    const embed = new EmbedBuilder()
      .setTitle("Moderation Logs")
      .setColor("#ff0000");

    // Fetch mute logs
    db.all("SELECT * FROM mutes ORDER BY end_time DESC", async (err, rows) => {
      if (err) {
        return await interaction.reply({ content: "Error fetching logs", ephemeral: true });
      }

      for (const row of rows) {
        const user = await client.users.fetch(row.user_id);
        const mod = await client.users.fetch(row.moderator_id);
        
        embed.addFields({
          name: `Mute - ${new Date(row.end_time).toLocaleString()}`,
