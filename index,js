client.once("ready", async () => {
  // Check for expiring roles every hour
  setInterval(() => {
    db.all(`
      SELECT ua.*, e.email, u.id as user_id
      FROM user_accounts ua 
      JOIN emails e ON ua.email_id = e.id
    `, async (err, rows) => {
      if (err) return;

      for (const row of rows) {
        const startDate = new Date(row.start_date);
        const endDate = new Date(startDate);
        endDate.setMonth(endDate.getMonth() + row.months);
        const daysLeft = Math.ceil((endDate - new Date()) / (1000 * 60 * 60 * 24));

        if (daysLeft <= 0) {
          // Remove roles
          const guild = await client.guilds.fetch(process.env.GUILD_ID);
          const member = await guild.members.fetch(row.user_id);
          await member.roles.remove("1360965335196631050");
          
          const durationRoles = {
            1: "1363830169168773160",
            3: "1363830255856521437",
            6: "1363830301217788035"
          };
          await member.roles.remove(durationRoles[row.months]);

          // Notify admin
          const adminChannel = await guild.channels.fetch(process.env.ADMIN_CHANNEL_ID);
          adminChannel.send(`Access expired for ${member.user.tag} (${row.email})`);

          // Remove from database
          db.run("DELETE FROM user_accounts WHERE id = ?", [row.id]);
        } else if (daysLeft <= 3) {
          // Notify user and admin about expiration
          const guild = await client.guilds.fetch(process.env.GUILD_ID);
          const member = await guild.members.fetch(row.user_id);
          const adminChannel = await guild.channels.fetch(process.env.ADMIN_CHANNEL_ID);
          
          member.send(`Your ChatGPT access will expire in ${daysLeft} days!`);
          adminChannel.send(`${member.user.tag}'s access (${row.email}) will expire in ${daysLeft} days!`);
        }
      }
    });
  }, 3600000); // Check every hour
  console.log(`🤖 Bot logged in as ${client.user.tag}`);

  try {
    console.log('Started refreshing application (/) commands.');
    
    await rest.put(
      Routes.applicationGuildCommands(client.user.id, process.env.GUILD_ID),
      { body: commands }
    );

    console.log('✅ Successfully reloaded application (/) commands.');
  } catch (error) {
    console.error('❌ Error registering commands:', error);
  }
});

client.on("interactionCreate", async (interaction) => {
  if (interaction.isButton()) {
    if (interaction.customId.startsWith('ticket_')) {
      const category = interaction.customId.split('_')[1];
      const channel = await interaction.guild.channels.create({
        name: `ticket-${interaction.user.username}-${category}`,
        type: 0,
        permissionOverwrites: [
          {
            id: interaction.guild.id,
            deny: ['ViewChannel'],
          },
          {
            id: interaction.user.id,
            allow: ['ViewChannel', 'SendMessages'],
          },
        ],
      });

      if (category === 'replace') {
        const requirementsEmbed = new EmbedBuilder()
          .setColor("#ff6b6b")
          .setTitle("Account Replacement Requirements")
          .setDescription("Please provide the following information:")
          .addFields([
            { name: "Type", value: "Enter the account type you need replaced", inline: false },
            { name: "Problem", value: "Describe the issue you're experiencing", inline: false },
            { name: "Image", value: "Upload a screenshot showing the problem", inline: false },
            { name: "Order Number", value: "Your order number if applicable", inline: false }
          ]);

        await channel.send({ embeds: [requirementsEmbed] });
        
        // Send notification to admin channel
        const adminChannel = await interaction.guild.channels.fetch("1366331901052190810");
        await adminChannel.send(`New replacement ticket opened by ${interaction.user.tag} in ${channel}`);
      }

      await interaction.reply({ content: `Ticket created in ${channel}`, ephemeral: true });
    }
  }
  if (!interaction.isChatInputCommand()) return;

  if (interaction.commandName === "post_tos") {
    try {
      const tosEmbed = new EmbedBuilder()
        .setColor("#2ecc71")
        .setTitle("📄 Terms and Conditions")
        .setDescription(
          `**💸 Accepted Payment Methods:**\n` +
            `- PayPal (friends & family)\n` +
            `- Card via PayPal\n\n` +
            `**❗ Other Payment Methods?**\n` +
            `If you wish to pay using another method (Paysafe, Skrill, etc.), please open a ticket.\n\n` +
            `**⚠️ Refund Policy:**\n` +
            `Once the order is placed and the service has begun, **no refunds can be made**.\n\n` +
            `By placing an order, you agree to these terms.`,
        )
        .setFooter({ text: "Thank you for your trust!" })
        .setTimestamp();

      await interaction.reply({ embeds: [tosEmbed] });
    } catch (error) {
      console.error("Error executing /post_tos command:", error);
      await interaction.reply({
        content: "There was an error executing this command!",
        ephemeral: true,
      });
    }
  }

  if (interaction.commandName === "create") {
    try {
      const title = interaction.options.getString("title");
      const description = interaction.options.getString("description");
      const stock = interaction.options.getInteger("stock");

      const formattedDescription = description.replace(/\\n/g, '\n');
      const link = interaction.options.getString("link");
      
      const price = interaction.options.getNumber("price");
      
      const menuEmbed = new EmbedBuilder()
        .setColor("#0099ff")
        .setTitle(`🎯 ${title}`)
        .setDescription(formattedDescription)
        .addFields([
          { name: "💰 Price", value: `\`€${price.toFixed(2)}\``, inline: true },
          { name: "📦 Stock Available", value: `\`${stock}\` units`, inline: true },
          ...(link ? [{ name: "🔗 Link", value: link, inline: true }] : [])
        ])
        .setFooter({ text: "Updated" })
        .setTimestamp();

      await interaction.reply({ embeds: [menuEmbed] });
    } catch (error) {
      console.error("Error executing /create command:", error);
      await interaction.reply({
        content: "There was an error creating the menu!",
        ephemeral: true
      });
    }
  }

  if (interaction.commandName === "createpanel") {
    try {
      const email = interaction.options.getString("email");
      db.run("INSERT INTO emails (email) VALUES (?)", [email], function(err) {
        if (err) {
          interaction.reply({ content: "Email already exists in panel!", ephemeral: true });
        } else {
          interaction.reply({ content: `Added email ${email} to panel`, ephemeral: true });
        }
      });
    } catch (error) {
      console.error("Error in createpanel:", error);
      interaction.reply({ content: "Error creating panel", ephemeral: true });
    }
  }

  if (interaction.commandName === "add") {
    try {
      const user = interaction.options.getUser("user");
      const email = interaction.options.getString("email");
      const months = interaction.options.getInteger("months");
      
      db.get("SELECT id FROM emails WHERE email = ?", [email], async (err, row) => {
        if (err || !row) {
          return interaction.reply({ content: "Email not found in panel!", ephemeral: true });
        }

        const startDate = new Date().toISOString();
        db.run("INSERT INTO user_accounts (user_id, email_id, months, start_date) VALUES (?, ?, ?, ?)",
          [user.id, row.id, months, startDate], async function(err) {
          if (err) {
            return interaction.reply({ content: "User already has an active account!", ephemeral: true });
          }

          const member = await interaction.guild.members.fetch(user.id);
          await member.roles.add("1360965335196631050"); // ChatGPT role

          // Add duration-specific role
          const durationRoles = {
            1: "1363830169168773160",
            3: "1363830255856521437",
            6: "1363830301217788035"
          };
          await member.roles.add(durationRoles[months]);

          interaction.reply({ content: `Added ${user.tag} to ${email} for ${months} month(s)`, ephemeral: true });
        });
      });
    } catch (error) {
      console.error("Error in add:", error);
      interaction.reply({ content: "Error adding user", ephemeral: true });
    }
  }

  if (interaction.commandName === "panel") {
    try {
      db.all(`
        SELECT ua.user_id, e.email, ua.months, ua.start_date 
        FROM user_accounts ua 
        JOIN emails e ON ua.email_id = e.id
      `, async (err, rows) => {
        if (err) {
          return interaction.reply({ content: "Error fetching panel data!", ephemeral: true });
        }

        const embed = new EmbedBuilder()
          .setColor("#0099ff")
          .setTitle("ChatGPT Account Panel")
          .setDescription("Current active accounts:");

        for (const row of rows) {
          const user = await client.users.fetch(row.user_id);
          const startDate = new Date(row.start_date);
          const endDate = new Date(startDate);
          endDate.setMonth(endDate.getMonth() + row.months);
          const daysLeft = Math.ceil((endDate - new Date()) / (1000 * 60 * 60 * 24));

          embed.addFields({
            name: user.tag,
            value: `Email: ${row.email}\nDuration: ${row.months} month(s)\nDays remaining: ${daysLeft}`,
            inline: true
          });
        }

        interaction.reply({ embeds: [embed], ephemeral: true });
      });
    } catch (error) {
      console.error("Error in panel:", error);
      interaction.reply({ content: "Error displaying panel", ephemeral: true });
    }
  }

  if (interaction.commandName === "setupticket") {
    const channel = interaction.options.getChannel("channel");
    
    const embed = new EmbedBuilder()
      .setColor("#0099ff")
      .setTitle("🎫 Support Ticket System")
      .setDescription("Click a button below to create a ticket:");

    const row = new ActionRowBuilder()
      .addComponents(
        new ButtonBuilder()
          .setCustomId('ticket_replace')
          .setLabel('Replace Account')
          .setStyle(ButtonStyle.Primary)
          .setEmoji('🔄'),
        new ButtonBuilder()
          .setCustomId('ticket_support')
          .setLabel('Support')
          .setStyle(ButtonStyle.Success)
          .setEmoji('❓'),
        new ButtonBuilder()
          .setCustomId('ticket_buy')
          .setLabel('Buy')
          .setStyle(ButtonStyle.Secondary)
          .setEmoji('💰')
      );

    await channel.send({ embeds: [embed], components: [row] });
    await interaction.reply({ content: "Ticket panel setup complete!", ephemeral: true });
  }

  if (interaction.commandName === "setupmanage") {
    const role = interaction.options.getRole("role");
    db.run("CREATE TABLE IF NOT EXISTS manage_roles (role_id TEXT PRIMARY KEY)");
    db.run("INSERT OR REPLACE INTO manage_roles (role_id) VALUES (?)", [role.id]);
    await interaction.reply({ content: `Set ${role.name} as management role`, ephemeral: true });
  }

  if (interaction.commandName === "mute") {
    // Check if user has management role
    const hasRole = await new Promise((resolve) => {
      db.get("SELECT role_id FROM manage_roles", [], (err, row) => {
        if (err) resolve(false);
        resolve(interaction.member.roles.cache.has(row?.role_id));
      });
    });

    if (!hasRole) {
      return await interaction.reply({ content: "You don't have permission to use this command!", ephemeral: true });
    }

    const user = interaction.options.getUser("user");
    const minutes = interaction.options.getInteger("minutes");
    const reason = interaction.options.getString("reason");
    const endTime = new Date(Date.now() + minutes * 60000).toISOString();

    db.run("INSERT INTO mutes (user_id, moderator_id, reason, end_time) VALUES (?, ?, ?, ?)",
      [user.id, interaction.user.id, reason, endTime]);

    const member = await interaction.guild.members.fetch(user.id);
    await member.timeout(minutes * 60000, reason);
    
    await interaction.reply({ content: `Muted ${user.tag} for ${minutes} minutes: ${reason}`, ephemeral: true });
  }

  if (interaction.commandName === "setupreplace") {
    const type = interaction.options.getString("type");
    const account = interaction.options.getString("account");
    
    db.run("INSERT INTO replace_accounts (type, account) VALUES (?, ?)", [type, account]);
    await interaction.reply({ content: `Added ${type} replacement account`, ephemeral: true });
  }

  if (interaction.commandName === "replace") {
    const formEmbed = new EmbedBuilder()
      .setColor("#ff6b6b")
      .setTitle("🔄 Account Replacement Form")
      .setDescription("Please provide the following information:")
      .addFields([
        { name: "Type", value: "Enter the account type you need replaced", inline: false },
        { name: "Problem", value: "Describe the issue you're experiencing", inline: false },
        { name: "Image", value: "Upload a screenshot showing the problem", inline: false },
        { name: "Order Number (Optional)", value: "Your order number if applicable", inline: false }
      ]);

    await interaction.channel.send({ embeds: [formEmbed] });
    await interaction.reply({ content: "Replacement form sent to channel", ephemeral: true });
  }

  if (interaction.commandName === "historyreplace") {
    db.all("SELECT * FROM replace_history ORDER BY timestamp DESC", async (err, rows) => {
