        });
      }

      await interaction.reply({ embeds: [embed], ephemeral: true });
    });
  }

  if (interaction.commandName === "edit") {
    try {
      const messageId = interaction.options.getString("message_id");
      const message = await interaction.channel.messages.fetch(messageId);
      
      if (!message || !message.embeds[0]) {
        return await interaction.reply({ 
          content: "Could not find a menu post with that ID!", 
          ephemeral: true 
        });
      }

      const currentEmbed = message.embeds[0];
      const newTitle = interaction.options.getString("title") || currentEmbed.title.replace("🎯 ", "");
      const newDescription = interaction.options.getString("description")?.replace(/\\n/g, '\n') || currentEmbed.description;
      const newStock = interaction.options.getInteger("stock") || parseInt(currentEmbed.fields[0].value.match(/\d+/)[0]);
      const newPrice = interaction.options.getNumber("price") || parseFloat(currentEmbed.fields[0].value.replace(/[^0-9.]/g, ''));
      const newLink = interaction.options.getString("link") || (currentEmbed.fields[2]?.value || null);

      const updatedEmbed = new EmbedBuilder()
