        const helper = await client.users.fetch(row.helper_id);
        
        embed.addFields({
          name: `${new Date(row.timestamp).toLocaleString()}`,
          value: `User: ${user.tag}\nHelper: ${helper.tag}\nType: ${row.type}\nProblem: ${row.problem}\nOrder: ${row.order_number || 'N/A'}`
        });
